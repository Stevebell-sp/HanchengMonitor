<Window x:Class="GlassMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="瀚誠系統監控 設定" Width="720" Height="600"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Microsoft JhengHei UI" FontSize="13"
        Foreground="{DynamicResource FgBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="#01000000">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ───── 左側：標題與分頁 ───── -->
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="8,0,0,8"
                    MouseLeftButtonDown="Header_MouseDown">
                <DockPanel Margin="12,0,12,14">
                    <StackPanel DockPanel.Dock="Top" Margin="8,18,0,18">
                        <TextBlock Text="瀚誠系統監控" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="設定" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource FgDimBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Margin="10,0,0,0"
                               Foreground="{DynamicResource FgDimBrush}" FontSize="11"/>
                    <StackPanel x:Name="NavPanel">
                        <RadioButton x:Name="NavLook" Content="外觀" Tag="&#xE790;" Style="{StaticResource NavTab}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavBehavior" Content="版面與行為" Tag="&#xE713;" Style="{StaticResource NavTab}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavItems" Content="顯示項目" Tag="&#xE8FD;" Style="{StaticResource NavTab}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavGame" Content="遊戲模式" Tag="&#xE7FC;" Style="{StaticResource NavTab}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavFans" Content="風扇與水冷" Tag="&#xE9F3;" Style="{StaticResource NavTab}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAlert" Content="警示與紀錄" Tag="&#xE7BA;" Style="{StaticResource NavTab}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavUpdate" Content="更新" Tag="&#xE895;" Style="{StaticResource NavTab}" Checked="Nav_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ───── 右側：內容 ───── -->
            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" Height="20" Background="#01000000" MouseLeftButtonDown="Header_MouseDown"/>

                <DockPanel DockPanel.Dock="Bottom" Margin="22,8,18,16" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Content="完成" Style="{StaticResource GlassButton}" Click="Close_Click"/>
                    <Button DockPanel.Dock="Right" Content="恢復預設" Margin="0,0,8,0" Style="{StaticResource GlassButton}" Click="Reset_Click"/>
                </DockPanel>

                <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="22,0,22,8">

                        <!-- 外觀 -->
                        <StackPanel x:Name="PageLook">
                            <TextBlock Text="外觀" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="小工具的風格、顏色與玻璃質感。" Style="{StaticResource PageHint}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="風格" Style="{StaticResource RowLabel}"/>
                                        <RadioButton x:Name="StyleFancy" GroupName="style" Content="華麗" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                        <RadioButton x:Name="StyleSimple" GroupName="style" Content="簡約" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="主題" Style="{StaticResource RowLabel}"/>
                                        <RadioButton x:Name="ThemeDark" GroupName="theme" Content="深色玻璃" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                        <RadioButton x:Name="ThemeLight" GroupName="theme" Content="淺色玻璃" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                    </StackPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="配色" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                        <WrapPanel x:Name="SchemePanel"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="玻璃效果" Style="{StaticResource RowLabel}"/>
                                        <RadioButton x:Name="GlassAcrylic" GroupName="glass" Content="毛玻璃" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                        <RadioButton x:Name="GlassBlur" GroupName="glass" Content="單純模糊" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                    </StackPanel>
                                    <DockPanel Margin="0,6">
                                        <TextBlock Text="底色濃度" Style="{StaticResource RowLabel}" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="TintLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider x:Name="TintSlider" Minimum="0.05" Maximum="0.95" SmallChange="0.05" LargeChange="0.1"
                                                IsSnapToTickEnabled="True" TickFrequency="0.05" VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,6">
                                        <TextBlock Text="大小" Style="{StaticResource RowLabel}" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="ScaleLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider x:Name="ScaleSlider" Minimum="0.8" Maximum="1.6" SmallChange="0.1" LargeChange="0.1"
                                                IsSnapToTickEnabled="True" TickFrequency="0.1" VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 版面與行為 -->
                        <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                            <TextBlock Text="版面與行為" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="排列方式、更新頻率，以及小工具怎麼跟其他視窗相處。" Style="{StaticResource PageHint}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="排列" Style="{StaticResource RowLabel}"/>
                                        <RadioButton x:Name="LayoutH" GroupName="layout" Content="橫式" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                        <RadioButton x:Name="LayoutV" GroupName="layout" Content="直式" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="更新頻率" Style="{StaticResource RowLabel}"/>
                                        <RadioButton x:Name="Int05" GroupName="interval" Content="0.5 秒" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                        <RadioButton x:Name="Int1" GroupName="interval" Content="1 秒" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                        <RadioButton x:Name="Int2" GroupName="interval" Content="2 秒" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="視窗" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="LockBox" Content="鎖定位置（不能拖曳）" Style="{StaticResource Switch}" Margin="0,6,0,4"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                    <CheckBox x:Name="TopmostBox" Content="永遠置頂" Style="{StaticResource Switch}" Margin="0,6,0,4"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                    <CheckBox x:Name="AutoBox" Content="開機自動啟動" Style="{StaticResource Switch}" Margin="0,6,0,4"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="滑鼠穿透" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="ClickBox" Content="滑鼠穿透" Style="{StaticResource Switch}" Margin="0,6,0,0"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                    <TextBlock Text="開啟後滑鼠會直接點到後面的視窗；按住下面的按鍵可以暫時點選小工具（看詳細資訊、拖曳）。要關閉穿透請在系統匣圖示上按右鍵。"
                                               TextWrapping="Wrap" FontSize="11" Margin="44,2,0,4" Foreground="{DynamicResource FgDimBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="44,2,0,6">
                                        <TextBlock Text="暫時解除鍵" Width="74" VerticalAlignment="Center" Foreground="{DynamicResource FgDimBrush}"/>
                                        <RadioButton x:Name="PassAlt" GroupName="passkey" Content="Alt" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                        <RadioButton x:Name="PassCtrl" GroupName="passkey" Content="Ctrl" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                        <RadioButton x:Name="PassShift" GroupName="passkey" Content="Shift" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 顯示項目 -->
                        <StackPanel x:Name="PageItems" Visibility="Collapsed">
                            <TextBlock Text="顯示項目" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="開關要顯示的項目；按住左邊 ≡ 上下拖曳排序，點右邊色點自訂顏色。" Style="{StaticResource PageHint}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                                <StackPanel x:Name="ItemList"/>
                            </Border>
                        </StackPanel>

                        <!-- 遊戲模式 -->
                        <StackPanel x:Name="PageGame" Visibility="Collapsed">
                            <TextBlock Text="遊戲模式" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="遊戲在前景時自動置頂；不在遊戲時，除非開啟「永遠置頂」，否則不會置頂。" Style="{StaticResource PageHint}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="GameBox" Content="啟用遊戲模式" Style="{StaticResource Switch}" Margin="0,6,0,4"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                    <CheckBox x:Name="FullscreenBox" Content="全螢幕程式也算遊戲（瀏覽器、影片播放器除外）" Style="{StaticResource Switch}" Margin="0,6,0,4"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                    <TextBlock Text="遊戲程式名稱（用逗號分隔，不用加 .exe）" Margin="0,8,0,4" Foreground="{DynamicResource FgDimBrush}"/>
                                    <TextBox x:Name="GameListBox" Style="{StaticResource GlassText}" LostFocus="OnTextChanged" Margin="0,0,0,6"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="遊戲中的外觀" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="GameMiniBox" Content="遊戲中改用下面自訂的項目與排列" Style="{StaticResource Switch}" Margin="0,6,0,4"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                    <CheckBox x:Name="GameSimpleBox" Content="遊戲中改用簡約外觀（不發光，比較不搶畫面）" Style="{StaticResource Switch}" Margin="0,6,0,4"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                    <TextBlock Text="遊戲中顯示的項目" Margin="0,8,0,4" Foreground="{DynamicResource FgDimBrush}"/>
                                    <UniformGrid x:Name="GameItemGrid" Columns="3"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="遊戲中排列" Style="{StaticResource RowLabel}"/>
                                        <RadioButton x:Name="GameLayoutH" GroupName="glayout" Content="橫式" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                        <RadioButton x:Name="GameLayoutV" GroupName="glayout" Content="直式" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                    </StackPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="遊戲中位置" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                        <WrapPanel x:Name="GameAnchorPanel"/>
                                    </DockPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,2,0,6" Foreground="{DynamicResource FgDimBrush}"
                                               Text="選「自訂」時，在遊戲中直接拖曳小工具就會記住位置（開了滑鼠穿透要按住 Alt 拖曳）。「獨佔全螢幕」的遊戲會蓋過所有視窗，建議遊戲改用「無邊框視窗」模式。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 風扇與水冷 -->
                        <StackPanel x:Name="PageFans" Visibility="Collapsed">
                            <TextBlock Text="風扇與水冷" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="FanHint" Style="{StaticResource PageHint}"
                                       Text="主機板只回報「Fan #1、Fan #2…」這種接頭編號，請依下面的即時轉速，點選哪個是 CPU 風扇、哪個是水冷泵。水冷泵通常轉速比較高而且穩定（約 2000～3000 RPM）。"/>
                            <TextBlock Text="CPU 風扇" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <WrapPanel x:Name="CpuFanPanel" Margin="0,4"/>
                            </Border>
                            <TextBlock Text="水冷泵" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <WrapPanel x:Name="PumpPanel" Margin="0,4"/>
                            </Border>
                            <TextBlock Style="{StaticResource PageHint}" Margin="2,10,0,0"
                                       Text="提示：拔掉或調整某顆風扇時看哪個數字變化，就能確認對應的接頭。「顯示項目」頁可以開關這兩格。"/>
                        </StackPanel>

                        <!-- 警示與紀錄 -->
                        <StackPanel x:Name="PageAlert" Visibility="Collapsed">
                            <TextBlock Text="警示與紀錄" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="過熱或滿載時提醒你，並每分鐘記錄溫度與使用率。" Style="{StaticResource PageHint}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="AlertBox" Content="啟用警示（格子會紅色閃爍）" Style="{StaticResource Switch}" Margin="0,6,0,4"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                    <DockPanel Margin="0,6">
                                        <TextBlock Text="CPU 溫度" Style="{StaticResource RowLabel}" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="CpuLimitLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider x:Name="CpuLimitSlider" Minimum="60" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                                VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,6">
                                        <TextBlock Text="GPU 溫度" Style="{StaticResource RowLabel}" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="GpuLimitLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider x:Name="GpuLimitSlider" Minimum="60" Maximum="95" IsSnapToTickEnabled="True" TickFrequency="1"
                                                VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,6">
                                        <TextBlock Text="記憶體" Style="{StaticResource RowLabel}" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="MemLimitLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider x:Name="MemLimitSlider" Minimum="70" Maximum="98" IsSnapToTickEnabled="True" TickFrequency="1"
                                                VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                                    </DockPanel>
                                    <CheckBox x:Name="NotifyBox" Content="跳出 Windows 通知（同一項 5 分鐘內只提醒一次）" Style="{StaticResource Switch}" Margin="0,6,0,4"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="歷史紀錄" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="HistoryBox" Content="每分鐘記錄溫度與使用率" Style="{StaticResource Switch}" Margin="0,6,0,4"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="保留天數" Style="{StaticResource RowLabel}"/>
                                        <RadioButton x:Name="Days7" GroupName="days" Content="7 天" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                        <RadioButton x:Name="Days30" GroupName="days" Content="30 天" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                        <RadioButton x:Name="Days90" GroupName="days" Content="90 天" Style="{StaticResource Seg}" Checked="OnAnyChanged"/>
                                    </StackPanel>
                                    <Button Content="查看歷史紀錄" HorizontalAlignment="Left" Margin="0,8,0,6" Style="{StaticResource GlassButton}" Click="History_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 更新 -->
                        <StackPanel x:Name="PageUpdate" Visibility="Collapsed">
                            <TextBlock Text="更新" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="從 GitHub Releases 取得新版本；下載的安裝檔會先驗證 SHA-256 才執行。" Style="{StaticResource PageHint}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="AutoInstallBox" Content="全自動更新" Style="{StaticResource Switch}" Margin="0,6,0,0"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                    <TextBlock Text="發現新版本就直接在背景下載安裝，完成後自動重新開啟，不會詢問；遊戲中會等你離開遊戲再更新。"
                                               TextWrapping="Wrap" FontSize="11" Margin="44,2,0,6" Foreground="{DynamicResource FgDimBrush}"/>
                                    <CheckBox x:Name="AutoUpdateBox" Content="自動檢查新版本（啟動時與每 6 小時）" Style="{StaticResource Switch}" Margin="0,6,0,0"
                                              Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                    <TextBlock Text="關閉全自動更新時，發現新版本只會通知你，由你在小工具上按右鍵選擇更新。"
                                               TextWrapping="Wrap" FontSize="11" Margin="44,2,0,6" Foreground="{DynamicResource FgDimBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                                        <Button Content="立即檢查" Style="{StaticResource GlassButton}" Click="CheckUpdate_Click"/>
                                        <TextBlock x:Name="UpdateStatus" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330"
                                                   Foreground="{DynamicResource FgDimBrush}" FontSize="11.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="進階" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="GitHub 儲存庫（帳號/名稱）" Margin="0,4,0,4" Foreground="{DynamicResource FgDimBrush}"/>
                                    <TextBox x:Name="UpdateRepoBox" Style="{StaticResource GlassText}" LostFocus="OnTextChanged" Margin="0,0,0,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </DockPanel>

            <!-- 關閉鈕疊在右上角 -->
            <Button Grid.Column="1" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" FontSize="13"
                    Style="{StaticResource IconButton}" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
